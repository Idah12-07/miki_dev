# ---------------------------------------------------------------------------
# miki-payment environment template
# Copy to `.env` and fill in. `.env` is gitignored: never put real values here.
# Every value below is intentionally blank or a placeholder.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port the API listens on
SERVER_PORT=3000
# Log verbosity (error | warn | info | debug | trace)
RUST_LOG=info

# --- Database (MariaDB) -----------------------------------------------------
# Option A (recommended): individual fields.
# sqlx builds the connection internally, so passwords with special characters
# such as @ : / are safe.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=miki_payment
DB_USER=
DB_PASSWORD=

# Option B: full connection string. Used instead of DB_* when set.
# DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/miki_payment

# --- BTCPay Server -----------------------------------------------------------
# Required (all three) for POST /api/v1/orders/{id}/invoice; if any is
# missing the API still boots and that endpoint answers 503.
# API key needs the `btcpay.store.cancreateinvoice` permission.
# The store's rate source must be able to price the order currency —
# this app never converts currencies itself.
# Never put real values in this file; `.env` is gitignored.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
